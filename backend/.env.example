# ================= ENVIRONMENT & CORE SECURITY =================
# Set ENVIRONMENT to 'production' on deployed servers (enforces required SECRET_KEY)
ENVIRONMENT=development

# Required in production. Generate a strong 32+ char key (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-in-production-to-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ================= CORS CONFIGURATION =================
# Comma-separated list of allowed frontend origins in production
# Example: ALLOWED_ORIGINS=https://offerstackr.vercel.app,https://myjobtracker.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ================= DATABASE CONFIGURATION =================
# SQLite (Local default):
DATABASE_URL=sqlite:///./jobtracker.db
# PostgreSQL (Production recommended):
# DATABASE_URL=postgresql://user:password@hostname:5432/offerstackr_db

# ================= EMAIL & SMTP CONFIGURATION =================
# For development, you can leave these empty. The system will safely log OTP codes to the terminal.
# To send real emails via Gmail:
# 1. Enable 2-Step Verification in your Google Account.
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in the values below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_TLS=true
EMAILS_FROM=OfferStackr <your-email@gmail.com>
